N <- 20
x <- 1
#f <- function(x) cos(x)
f <- function(x) 10*cos(x)
for (n in 1:N) {
x <- x - (f(x) - x)^2 / (f(f(x)) - 2*f(x) + x)
cat("n =", n, "Aitken-Steffensen =", x, "\n")
}
