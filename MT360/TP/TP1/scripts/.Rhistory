#f <- function(x) cos(x)
#f <- function(x) 10*cos(x)
for (n in 1:N-2) {
x[n+1] <- f(x[n])
if (n >= 2) {
aitken <- x[n] - (x[n+1] - x[n])^2 / (x[n+2] - 2*x[n+1] + x[n])
cat("n =", n, "Delta2 Aitken =", aitken, "\n")
}
}
