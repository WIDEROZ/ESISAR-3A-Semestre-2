X <- c(1, 1)
#X <- c(-3, 0)
err <- numeric(N)
for(n in 1:N){
err[n]
F <- c(X[1]-1/2*(X[2]^2-X[1]^2), X[2]-1+X[1]^2 * X[2])
JF <- matrix(c(1+X[1], -X[2], 2*X[1]*X[2], 1+X[1]^2), 2, 2, byrow=TRUE)
JF_inv <- solve(JF)
X <- X - JF_inv %*% F
err[n+1]
if(n>=2){
p <- log(err[n+1]/err[n])/log(err[n]/err[n-1])
}
cat("n =", n, "\n Ordre = \n", p, "\n")
}
norme <- function(err) sqrt(err[1]^2 + err[2]^2)
norme(c(1, 1))
norme(c(2, 2))
norme(c(4, 6))
norme(c(4, 0))
norme(c(0, 4))
